{
    "buildCommand": "chmod +x build.sh && ./build.sh",
    "outputDirectory": "site/public",
    "rewrites": [
        {
            "source": "/app/(.*)",
            "destination": "/api/index.js"
        },
        {
            "source": "/(.*)",
            "destination": "/$1"
        }
    ],
    "headers": [
        {
            "source": "/app/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        }
    ]
}